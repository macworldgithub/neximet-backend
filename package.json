{
  "name": "neximet-backend",
  "version": "1.0.0",
  "description": "Neximet Multi-Department Enterprise Portal Backend",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --experimental-require-module src/server.js",
    "dev": "node --experimental-require-module --watch src/server.js",
    "check:production": "node --experimental-require-module scripts/check-production.js",
    "setup:production": "node scripts/setup-production-env.js",
    "test:production": "node --experimental-require-module --test test/production.test.js",
    "test:proxy": "node --test test/deployment-proxy.test.js",
    "test:chat": "node --test test/chat.test.js",
    "test:mail": "node --test test/mail.test.js test/mail-runtime.test.js",
    "test:ai": "node --test test/ai.test.js test/ai-integration.test.js",
    "test:attendance": "node --test test/attendance-policy.test.js test/attendance.test.js",
    "seed": "node src/seed/seedRealUsers.js",
    "seed:legacy": "node src/seed/seedData.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^2.5.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.40",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.2",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
