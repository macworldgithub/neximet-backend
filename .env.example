# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/neximet_portal?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=neximet_super_secret_jwt_key_2026_enterprise_portal
JWT_EXPIRES_IN=7d

# Emergency Account Recovery
CEO_MASTER_KEY=NEXIMET-CEO-2026-RECOVERY

# Environment & Server
NODE_ENV=production
PORT=4000

# Vercel also sets this through vercel.json, before Node starts.
NODE_OPTIONS=--experimental-require-module

# Browser/PWA Web Push (run node scripts/configure-web-push.js for persistent keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://neximet.com

# Hostinger mailbox encryption (generate locally with node scripts/configure-mail.js)
# Keep this stable and private; set the same value on every backend instance.
MAIL_ENCRYPTION_KEY=
