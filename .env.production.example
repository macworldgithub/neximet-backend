NODE_ENV=production
HOST=127.0.0.1
PORT=4052
TRUST_PROXY=loopback
CORS_ORIGINS=https://portal.neximet.com,https://www.portal.neximet.com

# Use Atlas or an authenticated MongoDB replica set. Standalone MongoDB is not sufficient.
MONGODB_URI=
# Copy existing production secrets when migrating. setup:production creates blank keys only.
JWT_SECRET=
JWT_EXPIRES_IN=7d
MAIL_ENCRYPTION_KEY=
# Blank AI key reuses MAIL_ENCRYPTION_KEY. Keep the original key when migrating.
AI_ENCRYPTION_KEY=
# Blank disables emergency CEO recovery. Never use a public/example recovery key.
CEO_MASTER_KEY=

# Browser notifications (setup:production generates a missing pair).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://portal.neximet.com
